# Copy to .env.local and fill in. .env.local is git-ignored. Never commit real values.

# Firebase web app config (Firebase console > Project settings > Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check
# reCAPTCHA Enterprise site key. Needed for deployed builds. Optional in dev when
# the debug provider is used.
VITE_APPCHECK_SITE_KEY=
# Dev only. Leave empty to let the SDK generate a token and print it in the browser
# console, then register it in Firebase console > App Check > Manage debug tokens.
# Or paste an already-registered debug token here. Ignored in production builds.
# Required for `npm run smoke:cloud`, which runs in Node and cannot keep a generated token.
VITE_APPCHECK_DEBUG_TOKEN=

# true = use the mock device model (keyword overlap, labelled "mock" everywhere).
# false = use Gemini Nano through Firebase AI Logic (Chrome desktop 139+).
VITE_MOCK_DEVICE=true
# Error rate injected by the mock device model, between 0 and 1.
VITE_MOCK_ERROR_RATE=0.1